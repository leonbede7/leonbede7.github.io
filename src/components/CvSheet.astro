---
// The CV sheet. /cv/ renders the default content; private variants (see src/pages/cv-variant) reorder and re-weight it.
import Arrow from './Arrow.astro';
import { FACTS, SITE } from '../data/site';
import type { CvJob } from '../data/cv';

interface Props { role: string; profile: string; work: CvJob[]; skills: [string, string][]; pdf?: boolean }
const { role, profile, work, skills, pdf = true } = Astro.props;
// Absolute links, so the printed PDF points at the live site rather than the preview server it was rendered from.
const abs = (href: string) => new URL(href, SITE.origin).href;
---
<article class="cv wrap">
    <header class="cv__head">
      <div>
        <h1 class="title">{SITE.name}</h1>
        <p class="cv__role lt">{role}</p>
      </div>
      <ul class="cv__contact">
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.origin}>leonbede7.github.io</a></li>
        <li><a href={SITE.linkedin}>linkedin.com/in/leon-bede</a></li>
        <li><a href={SITE.github}>github.com/leonbede7</a></li>
        <li>{SITE.location}</li>
      </ul>
    </header>

    {pdf && <p class="cv__get no-print"><a class="cell cell--solid" href={abs('/leon-bede-cv.pdf')} download>Download as PDF <Arrow /></a></p>}

    <section class="cv__sec">
      <h2 class="lt">Profile</h2>
      <p class="cv__profile">{profile}</p>
    </section>

    <section class="cv__sec">
      <h2 class="lt">Engineering experience</h2>
      <div class="cv__work">
        {work.map((w) => (
          <div class="job">
            <h3>{w.href ? <a href={abs(w.href)}><b class="title">{w.name}</b></a> : <b class="title">{w.name}</b>} <span>{w.what}</span></h3>
            <p class="job__when lt tnum">{w.when}</p>
            <ul>{w.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <div class="cv__two">
      <section class="cv__sec">
        <h2 class="lt">Other experience</h2>
        <div class="job">
          <h3><b class="title">Automobili Galerija</b> <span>Business operations and AI product development</span></h3>
          <p class="job__when lt tnum">2021 to present</p>
          <ul><li>Daily dealership work in stock, inquiries, trade-ins and sales; turned that into the requirements for the products above and own their direction.</li></ul>
        </div>
        <div class="job">
          <h3><b class="title">Hrvatski Telekom</b> <span>Sales and customer service agent</span></h3>
          <p class="job__when lt tnum">Summer 2024</p>
          <ul><li>Explained service options to customers and regularly exceeded individual sales targets.</li></ul>
        </div>
      </section>

      <section class="cv__sec">
        <h2 class="lt">Education</h2>
        <div class="job">
          <h3><b class="title">FERIT Osijek</b> <span>Undergraduate Computing, Software Engineering track</span></h3>
          <p class="job__when lt">In progress</p>
        </div>
        <h2 class="lt cv__h2b">Languages</h2>
        <p>Croatian, native. English, C1 (advanced).</p>
      </section>
    </div>

    <section class="cv__sec">
      <h2 class="lt">Skills</h2>
      <dl class="cv__skills">
        {skills.map(([k, v]) => <div><dt class="lt">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <p class="cv__note">The code in these projects was written by AI coding agents under my direction. Figures measured {FACTS.measured}.</p>
  </article>

<style>
  .cv { padding-block: clamp(2rem, 5vw, 4rem) 1rem; max-width: 62rem; }
  .cv__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; border-bottom: var(--wall) solid var(--poche); padding-bottom: 1.2rem; }
  .cv__head h1 { font-size: clamp(3rem, 2rem + 5vw, 5.4rem); }
  .cv__role { font-size: var(--step-1); margin-top: 0.3rem; }
  .cv__contact { font-size: var(--step--1); line-height: 1.55; text-align: right; font-weight: 500; }
  .cv__get { margin-top: 1.4rem; }
  .cv__get .cell { font-size: var(--step--1); }
  .cv__sec { margin-top: 2rem; }
  .cv__sec h2 { font-size: var(--step-0); color: var(--ink-2); border-bottom: 1px solid var(--poche); padding-bottom: 0.35rem; margin-bottom: 0.8rem; }
  .cv__h2b { margin-top: 1.6rem; }
  .cv__profile { font-size: var(--step-0); max-width: 52em; font-weight: 500; }
  .cv__work { display: grid; gap: 1.1rem; }
  .job { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.15rem 1.5rem; align-items: baseline; }
  .job + .job { margin-top: 0.9rem; }
  .cv__work .job + .job { margin-top: 0; }
  .job h3 { font-size: var(--step-0); font-weight: 500; }
  .job h3 b { font-size: var(--step-1); margin-right: 0.4em; }
  .job h3 a { text-decoration: none; }
  .job h3 a:hover b { text-decoration: underline; text-decoration-color: var(--sun-deep); }
  .job__when { font-size: var(--step--1); color: var(--ink-2); white-space: nowrap; }
  .job ul { grid-column: 1 / -1; display: grid; gap: 0.3rem; font-size: var(--step--1); line-height: 1.45; margin-top: 0.25rem; max-width: 60em; }
  .job li { padding-left: 1.2em; position: relative; }
  .job li::before { content: ''; position: absolute; left: 0; top: 0.68em; width: 0.65em; border-top: var(--wall) solid var(--poche); }
  .cv__two { display: grid; grid-template-columns: 1.4fr 1fr; gap: 0 3rem; }
  .cv__skills div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--rule); font-size: var(--step--1); line-height: 1.45; }
  .cv__skills dt { color: var(--ink-2); }
  .cv__note { margin-top: 1.6rem; font-size: var(--step--1); color: var(--ink-2); }
  @media (max-width: 46rem) {
    .cv__contact { text-align: left; }
    .cv__two { grid-template-columns: 1fr; }
    .job { grid-template-columns: 1fr; }
    .cv__skills div { grid-template-columns: 1fr; gap: 0.1rem; }
  }
  @media print {
    @page { size: A4; margin: 11mm 13mm; }
    :global(html) { font-size: 8.7pt; }
    :global(body) { background: #fff; }
    :global(.tb) { display: none; }
    .cv { padding: 0; max-width: none; }
    .cv__head h1 { font-size: 34pt; }
    .cv__sec { margin-top: 8pt; break-inside: avoid; }
    .cv__head { padding-bottom: 6pt; }
    .cv__sec h2 { margin-bottom: 4pt; }
    .cv__note { margin-top: 8pt; }
    .cv__work .job { break-inside: avoid; }
    .cv__work { gap: 5pt; }
    a { text-decoration: none; }
  }
</style>
