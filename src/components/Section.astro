---
// The dealership in section. Geometry comes from lib/building; light from lib/sun.
import { APERTURES, LEVEL, ROOMS, SUN_ARC, VIEW, WALL, type RoomId } from '../lib/building';
import { beamPath, beams, landing, litRooms, sunPosition, wallLanding } from '../lib/sun';
import { STOPS } from '../data/stops';

interface Props { time?: number; mini?: boolean; label?: string; used?: string[]; active?: string | null; numbers?: boolean }
const { time = 7, mini = false, label = 'Section through a car dealership. Each room is one product.', used = [], active = null, numbers = true } = Astro.props;

const lit = new Set(mini ? [] : litRooms(time));
const lands = new Map(beams(time).map((b) => [b.aperture, b.room === active ? landing(b) : null]));
const walls = new Map(beams(time).map((b) => [b.aperture, b.room === active ? wallLanding(b) : null]));
const shafts = new Map(beams(time).map((b) => [b.aperture, beamPath(b)]));
const GRID: [string, number][] = [['A', 80], ['B', 335], ['C', 553], ['D', 717], ['E', 920]];
const SPANS = GRID.slice(1).map(([, x], i) => ({ x0: GRID[i]![1], x1: x, m: ((x - GRID[i]![1]) / 46).toFixed(2) }));
const flight = (x: number, y: number, dir: 1 | -1) => `M${x} ${y}` + Array.from({ length: 8 }, () => `v-14.25h${dir * 13.75}`).join('');
const LEADERS: Record<string, [number, number]> = { assistant: [150, 250], arrival: [214, 590], valuation: [404, 262], showroom: [622, 480], street: [786, 572], desk: [804, 300], };
const sun = sunPosition(time);
const uid = mini ? 'm' : 's';

const TAGS: { room: RoomId; n: string; name: string; sub: string; x: number; y: number }[] = [
  { room: 'assistant', n: '1', name: 'Assistant', sub: 'morning brief', x: 122, y: 214 },
  { room: 'arrival', n: '2', name: 'Arrival bay', sub: 'intake, nothing retyped', x: 122, y: 440 },
  { room: 'valuation', n: '3', name: 'Valuation', sub: 'market data', x: 420, y: 214 },
  { room: 'showroom', n: '4', name: 'Showroom', sub: 'photo studio', x: 584, y: 214 },
  { room: 'street', n: '5', name: 'Street front', sub: 'site + 5 portals', x: 748, y: 440 },
  { room: 'desk', n: '6', name: 'Kokpit desk', sub: 'a person confirms', x: 748, y: 214 },
  { room: 'workshop', n: 'B', name: 'Workshop', sub: 'built and checked here', x: 120, y: 690 },
];

const ticks = STOPS.filter((s) => s.time > 6 && s.time < 19).map((s) => {
  const p = sunPosition(s.time)!;
  const a = Math.atan2(p.y - SUN_ARC.cy, (p.x - SUN_ARC.cx) * (SUN_ARC.ry / SUN_ARC.rx));
  return { id: s.id, clock: s.clock, x: p.x, y: p.y, lx: p.x + Math.cos(a) * 46, ly: p.y + Math.sin(a) * 30 - 2 };
});

const racks = Array.from({ length: 5 }, (_, i) => 304 + i * 36);
const dots: [number, number][] = [];
for (let r = 0; r < 6; r++) for (let c = 0; c < 22; c++) dots.push([668 + c * 10.4, 672 + r * 11]);
const R = (r: { x0: number; y0: number; x1: number; y1: number }) => ({ x: r.x0, y: r.y0, width: r.x1 - r.x0, height: r.y1 - r.y0 });
---
<svg
  class:list={['sec', { 'sec--mini': mini }]}
  viewBox={mini ? '52 118 896 646' : `0 0 ${VIEW.w} ${VIEW.h}`}
  role="img"
  aria-label={label}
  data-section
  data-time={time}
>
  <defs>
    <pattern id={`${uid}-hatch`} width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V9" stroke="currentColor" stroke-width="1.3" />
    </pattern>
    <pattern id={`${uid}-ray`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V7" stroke="#f3b62f" stroke-width="3.1" />
    </pattern>
    <g id={`${uid}-car`}>
      <path d="M2 26V18Q3 15 8 14L24 12 34 4Q36 2.5 40 2.5H60Q64 2.5 67 5L77 13 92 15Q98 16 98 21V26Z" />
      <circle cx="22" cy="26" r="7.4" /><circle cx="78" cy="26" r="7.4" />
    </g>
    <g id={`${uid}-front`}>
      <path d="M8 50V33Q8 26 15 24L23 8Q25 4 31 4H53Q59 4 61 8L69 24Q76 26 76 33V50Z" />
      <rect x="9" y="46" width="13" height="14" rx="2" /><rect x="62" y="46" width="13" height="14" rx="2" />
    </g>
    <g id={`${uid}-person`}>
      <circle cx="0" cy="-9" r="8" /><path d="M-10 70V42L-12 24Q-12 5 0 5T12 24L10 42V70H2.2V46H-2.2V70Z" />
    </g>
    <g id={`${uid}-shell`}>
      <rect x="66" y="156" width="286" height="28" /><rect x="402" y="156" width="198" height="28" /><rect x="670" y="156" width="264" height="28" />
      <rect x="342" y="134" width="10" height="22" /><rect x="402" y="134" width="10" height="22" />
      <rect x="590" y="120" width="10" height="36" /><rect x="670" y="120" width="10" height="36" />
      <rect x="66" y="156" width="28" height="48" /><rect x="66" y="316" width="28" height="124" /><rect x="66" y="626" width="28" height="134" />
      <rect x="906" y="156" width="28" height="48" /><rect x="906" y="316" width="28" height="124" /><rect x="906" y="626" width="28" height="134" />
      <rect x="94" y="396" width="452" height="16" /><rect x="724" y="396" width="182" height="16" />
      <rect x="328" y="184" width="14" height="146" /><rect x="546" y="184" width="14" height="332" /><rect x="710" y="184" width="14" height="332" />
      <rect x="66" y="640" width="868" height="20" /><rect x="52" y="742" width="896" height="18" />
    </g>
  </defs>

  <g class="sec__site">
    {!mini && (
      <g class="sec__sky" aria-hidden="true">
        <path class="arc" d={`M${SUN_ARC.cx - SUN_ARC.rx} ${SUN_ARC.cy}A${SUN_ARC.rx} ${SUN_ARC.ry} 0 0 1 ${SUN_ARC.cx + SUN_ARC.rx} ${SUN_ARC.cy}`} />
        {ticks.map((t) => (
          <g class="tick" data-tick={t.id}>
            <circle cx={t.x} cy={t.y} r="3.2" />
            <text x={t.lx} y={t.ly} text-anchor="middle">{t.clock}</text>
          </g>
        ))}
        <g class="sun" data-sun transform={sun ? `translate(${sun.x.toFixed(1)} ${sun.y.toFixed(1)})` : 'translate(500 -80)'}>
          <circle r="27" class="sun__halo" /><circle r="17" class="sun__disc" />
        </g>
      </g>
    )}

    <!-- room grounds: shade until the light arrives -->
    <g class="sec__rooms" aria-hidden="true">
      {(Object.keys(ROOMS) as RoomId[]).map((id) => (
        <rect class:list={['rm', { 'is-lit': lit.has(id), 'is-used': used.includes(id) }]} data-room={id} {...R(ROOMS[id])} />
      ))}
    </g>

    <!-- interiors -->
    <g class="sec__fit" aria-hidden="true">
      <g class="beyond">
        <path class="ln thin" d={flight(430, 640, 1) + 'h6' + flight(540, 526, -1)} />
        <path class="ln thin" d="M430 612L540 498M540 498L430 384" />
        <rect class="open" x="328" y="330" width="14" height="66" /><rect class="open" x="546" y="516" width="14" height="124" /><rect class="open" x="710" y="516" width="14" height="124" />
      </g>
      <g class="fit" data-fit="assistant">
        <rect class="ln fl" x="128" y="238" width="152" height="106" />
        <path class="ln" d="M128 258H280" />
        <path class="ln brief" d="M142 276H252M142 294H232M142 312H258M142 330H212" />
        <circle class="brief-dot" cx="266" cy="276" r="5" />
        <path class="ln" d="M142 368H266M152 368V396M256 368V396" />
        <circle class="ln fl" cx="304" cy="262" r="14" /><path class="ln" d="M304 252V262H311" />
      </g>

      <g class="fit" data-fit="valuation">
        <rect class="ln fl" x="356" y="246" width="96" height="86" />
        <g class="comps">
          <circle cx="368" cy="312" r="3.4" /><circle cx="378" cy="268" r="3.4" /><circle cx="388" cy="298" r="3.4" />
          <circle cx="398" cy="262" r="3.4" /><circle cx="408" cy="306" r="3.4" /><circle cx="418" cy="282" r="3.4" />
          <circle cx="428" cy="318" r="3.4" /><circle cx="438" cy="274" r="3.4" /><circle cx="404" cy="290" r="3.4" />
        </g>
        <path class="ln median" d="M362 290H446" />
        <path class="ln" d="M472 396V236M536 396V236M472 236H536M472 276H536M472 316H536M472 356H536" />
        <path class="ln fl" d="M478 276V258H496V276M502 276V262H516V276M480 316V296H506V316M512 316V302H530V316M478 356V338H494V356M500 356V334H528V356M482 396V374H520V396" />
      </g>

      <g class="fit" data-fit="desk">
        <path class="ln" d="M764 338H876M772 338V396M868 338V396" />
        <rect class="ln fl" x="800" y="296" width="46" height="30" /><path class="ln" d="M823 326V338M812 338H834" />
        <use href={`#${uid}-person`} class="solid" transform="translate(748 326)" />
        <g class="proposal">
          <rect class="ln fl" x="836" y="246" width="58" height="42" />
          <path class="ln" d="M845 259H885M845 271H872" />
          <g class="stamp"><circle cx="886" cy="284" r="11" /><path d="M880 284l4.5 4.5 8-9" /></g>
        </g>
      </g>

      <g class="fit" data-fit="arrival">
        <g class="incoming"><g transform="translate(-56 0)"><use href={`#${uid}-car`} class="solid" transform="translate(166 576.2) scale(1.9)" /><path class="win" d="M235 586 221 599H259V586ZM265 586V599H305L290 586Z" /></g></g>
        <use href={`#${uid}-person`} class="solid" transform="translate(326 570)" />
        <g class="doc" transform="translate(-96 0)">
          <rect class="ln fl" x="438" y="458" width="78" height="106" />
          <path class="ln" d="M450 478H504" />
          <path class="mask" d="M450 494H490M450 508H478" />
          <path class="ln" d="M450 524H504M450 538H496M450 552H484" />
          <path class="scan" d="M434 470H520" />
        </g>
      </g>

      <g class="fit" data-fit="showroom">
        <path class="cyc" d="M574 640V508Q574 478 604 478H666Q696 478 696 508V640Z" />
        <path class="lot" d="M574 640V508Q574 478 604 478H666Q696 478 696 508V640Z" fill={`url(#${uid}-hatch)`} />
        <use href={`#${uid}-front`} class="solid" transform="translate(585 568) scale(1.2)" />
        <path class="ln fl" d="M601 588h18l4 10h-26zM651 588h18l4 10h-26z" />
        <path class="ln" d="M566 640V556M704 640V556" /><path class="ln fl" d="M560 528l14 6v24l-14 6zM710 528l-14 6v24l14 6z" />
      </g>

      <g class="fit" data-fit="street">
        <rect class="ln fl" x="738" y="632" width="108" height="8" />
        <use href={`#${uid}-front`} class="solid" transform="translate(746 566) scale(1.1)" />
        <path class="ln fl" d="M791 583h16l4 9h-24z" />
        <path class="ln" d="M874 640V566" /><rect class="ln fl sticker" x="854" y="514" width="40" height="52" />
        <path class="ln" d="M862 528H886M862 540H880" /><path class="mask" d="M862 554H886" />
      </g>

      <g class="fit" data-fit="workshop">
        {racks.map((x) => (
          <g><rect class="ln fl" x={x} y="670" width="28" height="72" /><path class="ln thin" d={`M${x + 6} 684h16M${x + 6} 698h16M${x + 6} 712h16M${x + 6} 726h16`} /></g>
        ))}
        <path class="ln" d="M486 712H652M494 712V742M644 712V742" />
        <path class="ln fl" d="M504 712V696H524V712M540 712V696H560V712M576 712V696H596V712M612 712V696H632V712" />
        <g class="tests">{dots.map(([x, y], i) => <circle cx={x} cy={y} r="2.5" style={`--i:${i}`} />)}</g>
      </g>
    </g>

    <!-- shafts of direct light: solid in the active room, hatched where the sun merely falls -->
    <g class="sec__beams" aria-hidden="true">
      {APERTURES.map((a) => <path class:list={['beam', { 'is-active': a.room === active }]} data-beam={a.id} data-room={a.room} d={shafts.get(a.id) ?? ''} style={`--ray:url(#${uid}-ray)`} />)}
    </g>

    <g class="sec__land" aria-hidden="true">
      {APERTURES.map((a) => { const l = lands.get(a.id); return <rect class="land" data-land={a.id} x={l ? l.x0 : 0} y={l ? l.y - 7 : 0} width={l ? l.x1 - l.x0 : 0} height="7" style={l ? undefined : 'display:none'} />; })}
      {APERTURES.map((a) => { const w = walls.get(a.id); const left = w ? w.x <= ROOMS[a.room].x0 + 0.6 : false; return <rect class="land" data-wall={a.id} x={w ? (left ? w.x : w.x - 7) : 0} y={w ? w.y0 : 0} width="7" height={w ? w.y1 - w.y0 : 0} style={w ? undefined : 'display:none'} />; })}
    </g>

    <!-- structure, cut -->
    <g class="sec__poche" aria-hidden="true">
      <use href={`#${uid}-shell`} />
      <path class="glass" d="M77 204V316M83 204V316M77 440V626M83 440V626M917 204V316M923 204V316M917 440V626M923 440V626M342 136H412M590 122H680" />
      {!mini && (
        <>
          <path class="groundline" d="M-40 642H66M934 642H2100" />
          <rect class="earth" x="-40" y="646" width="92" height="124" fill={`url(#${uid}-hatch)`} />
          <rect class="earth" x="948" y="646" width="92" height="124" fill={`url(#${uid}-hatch)`} />
          <rect class="earth" x="52" y="760" width="896" height="10" fill={`url(#${uid}-hatch)`} />
        </>
      )}
    </g>

    {!mini && (
      <g class="sec__site-marks" aria-hidden="true">
        {[[640, '±0.00'], [396, '+4.20']].map(([y, t]) => (
          <g class="level"><path class="ln thin" d={`M4 ${y}H60M12 ${y}l7 -11h-14z`} /><text x="26" y={Number(y) - 7}>{t}</text></g>
        ))}
        {GRID.map(([l, x]) => (
          <g class="gridmark"><path class="ln thin dash" d={`M${x} 762V779`} /><circle cx={x} cy="792" r="12" /><text x={x} y="797.5" text-anchor="middle">{l}</text></g>
        ))}
        {SPANS.map((d) => (
          <g class="dim"><path class="ln thin" d={`M${d.x0 + 13} 792H${d.x1 - 13}`} /><text x={(d.x0 + d.x1) / 2} y="787" text-anchor="middle">{d.m}</text></g>
        ))}
      </g>
    )}

    {!mini && (
      <g class="sec__street" aria-hidden="true">
        <use href={`#${uid}-person`} class="solid" transform="translate(962 570)" />
        <path class="ln" d="M992 640V452" />
        <g class="signs">
          {[0, 1, 2, 3, 4].map((i) => <rect x="958" y={458 + i * 19} width="34" height="13" style={`--i:${i}`} />)}
        </g>
      </g>
    )}

    {!mini && (
      <g class="sec__next" aria-hidden="true">
        <path class="core" d="M52 760H1934V796H52Z" /><text class="core-txt" x="993" y="786" text-anchor="middle">One core under every building</text>
        <g transform="translate(980 0)">
          <rect class="rm" x="94" y="184" width="812" height="456" /><rect class="rm" x="94" y="660" width="812" height="82" />
          <use href={`#${uid}-shell`} />
          <path class="glass" d="M85 204V316M89 204V316M85 440V626M89 440V626M911 204V316M915 204V316M911 440V626M915 440V626" />
          <use href={`#${uid}-car`} class="solid" transform="translate(166 576.2) scale(1.9)" />
          <use href={`#${uid}-front`} class="solid" transform="translate(585 568) scale(1.2)" />
          <text class="lbl" x="66" y="850">Installation 2, demo dealership</text>
          <text class="sub" x="66" y="886">own data, own brand, own database</text>
        </g>
        <text class="lbl" x="66" y="850">Installation 1, Automobili Galerija</text>
        <text class="sub" x="66" y="886">the first dealership, in daily use</text>
      </g>
    )}

    <!-- room numbers and names -->
    {!mini && (
      <g class="sec__tags" aria-hidden="true">
        {TAGS.map((t) => (
          <g class="tg" data-tag={t.room}>
            {LEADERS[t.room] && <path class="lead" d={`M${t.x} ${t.y}L${LEADERS[t.room]![0]} ${LEADERS[t.room]![1]}`} />}
            {LEADERS[t.room] && <circle class="lead-dot" cx={LEADERS[t.room]![0]} cy={LEADERS[t.room]![1]} r="3" />}
            <circle cx={t.x} cy={t.y} r="14" />
            <text class="num" x={t.x} y={t.y + 6.2} text-anchor="middle">{t.n}</text>
            <text class:list={['lbl', { 'lbl--tight': t.room === 'showroom' }]} x={t.x + 23} y={t.y + 1}>{t.name}</text>
            <text class="sub" x={t.x + 23} y={t.y + 17}>{t.sub}</text>
          </g>
        ))}
      </g>
    )}
    {mini && numbers && (
      <g class="sec__tags" aria-hidden="true">
        {TAGS.map((t) => (
          <g class:list={['tg', { 'is-used': used.includes(t.room) }]} data-tag={t.room}>
            <circle cx={(ROOMS[t.room].x0 + ROOMS[t.room].x1) / 2} cy={t.room === 'workshop' ? 698 : t.room === 'showroom' ? 420 : (ROOMS[t.room].y0 + ROOMS[t.room].y1) / 2} r="26" />
            <text class="num" x={(ROOMS[t.room].x0 + ROOMS[t.room].x1) / 2} y={(t.room === 'workshop' ? 698 : t.room === 'showroom' ? 420 : (ROOMS[t.room].y0 + ROOMS[t.room].y1) / 2) + 11} text-anchor="middle">{t.n}</text>
          </g>
        ))}
      </g>
    )}
  </g>
</svg>

<style is:global>
  .sec {
    --d-ink: var(--poche);
    --d-room: var(--shade);
    --d-lit: var(--ground);
    --d-paper: var(--ground);
    width: 100%; height: auto; overflow: visible;
    color: var(--d-ink);
    font-family: var(--letter);
  }
  .sec__site { transform-box: view-box; transform-origin: 0% 50%; transition: transform 1.1s var(--ease); }

  .sec .rm { fill: var(--d-room); transition: fill 0.7s var(--ease); }
  .sec .rm.is-lit { fill: var(--d-lit); }
  .sec__beams { mix-blend-mode: multiply; }
  .sec .beam { fill: var(--ray); }
  .sec .beam.is-active { fill: var(--sun); }
  .sec--mini .beam, .sec--mini .land { display: none; }

  .sec .ln { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: square; stroke-linejoin: miter; }
  .sec .ln.thin { stroke-width: 1.1; }
  .sec .ln.dash { stroke-dasharray: 3 4; }
  .sec .win { fill: var(--d-paper); }
  .sec .beyond { opacity: 0.62; }
  .sec .open { fill: var(--d-room); stroke: currentColor; stroke-width: 1.1; }
  .sec .land { fill: #fff6d6; }
  .sec .lead { fill: none; stroke: currentColor; stroke-width: 1.1; }
  .sec .tg circle.lead-dot { fill: currentColor; stroke: none; }
  .sec .dim text { font-size: 12.5px; font-style: italic; font-weight: 600; letter-spacing: 0.04em; fill: currentColor; font-variant-numeric: tabular-nums; }
  .sec .core-txt { font-size: 22px; font-weight: 850; font-style: italic; text-transform: uppercase; letter-spacing: 0.08em; fill: var(--d-paper); }
  .sec .gridmark circle { fill: var(--d-paper); stroke: currentColor; stroke-width: 1.4; }
  .sec .gridmark text { font-size: 15px; font-weight: 700; fill: currentColor; }
  .sec .ln.fl { fill: var(--d-paper); }
  .sec .solid { fill: currentColor; }
  .sec .mask { stroke: currentColor; stroke-width: 7; fill: none; }
  .sec__poche { fill: currentColor; }
  .sec .glass { stroke: currentColor; stroke-width: 1.2; fill: none; }
  .sec .groundline { stroke: currentColor; stroke-width: 4; fill: none; }
  .sec .earth { opacity: 0.55; }

  .sec .arc { fill: none; stroke: currentColor; stroke-width: 1.3; stroke-dasharray: 2 8; stroke-linecap: round; }
  .sec .level text { font-size: 13px; font-style: italic; font-weight: 600; letter-spacing: 0.04em; fill: currentColor; font-variant-numeric: tabular-nums; }
  .sec .tick circle { fill: currentColor; }
  .sec .tick text { font-size: 14px; font-style: italic; font-weight: 600; letter-spacing: 0.06em; fill: currentColor; font-variant-numeric: tabular-nums; }
  .sec .sun__disc { fill: var(--sun); stroke: currentColor; stroke-width: 2.3; }
  .sec .sun__halo { fill: var(--sun); opacity: 0.22; }

  .sec .tg circle { fill: var(--d-paper); stroke: currentColor; stroke-width: 2.3; transition: fill 0.3s var(--ease); }
  .sec .tg .num { font-size: 18px; font-weight: 800; fill: currentColor; transition: fill 0.3s var(--ease); }
  .sec .lbl { font-size: 21px; font-weight: 850; font-style: italic; text-transform: uppercase; letter-spacing: 0.05em; fill: currentColor; }
  .sec .lbl.lbl--tight { font-size: 18.5px; }
  .sec .sub { font-size: 13px; font-weight: 600; font-style: italic; text-transform: uppercase; letter-spacing: 0.07em; fill: currentColor; }
  .sec .tg.is-active circle:not(.lead-dot) { fill: currentColor; }
  .sec .tg.is-active .num { fill: var(--d-paper); }

  .sec .cyc { fill: var(--d-paper); stroke: currentColor; stroke-width: 1.6; }
  .sec .lot { opacity: 0.5; transition: opacity 0.6s var(--ease), clip-path 1.1s var(--ease); clip-path: inset(0 0 0 0); }
  .sec .comps circle { fill: currentColor; transition: transform 0.9s var(--ease); transform-box: fill-box; }
  .sec .median { stroke-dasharray: 5 5; opacity: 0; transition: opacity 0.5s var(--ease) 0.5s; }
  .sec .brief-dot { fill: var(--sun); stroke: currentColor; stroke-width: 2; }
