---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { FACTS, SITE } from '../data/site';

const WORK = [
  {
    name: 'Kokpit',
    what: 'Founder and engineer. Platform for car dealerships',
    when: 'Sep 2026 to now',
    href: '/work/kokpit/',
    points: [
      'Designed the architecture: one Next.js core, a separate Postgres project and deployment per dealership; CI builds two tenants and proves no identity leaks between them.',
      `Directed coding agents across 4 apps, 8 packages and a Python service: ${FACTS.commits} commits, ${FACTS.tests} automated tests, ${FACTS.migrations} migrations. Runs one real dealership and a public demo installation.`,
      'Specified a market valuation engine with no language model in the pricing path, and price-history compliance for a new Croatian consumer law.',
    ],
  },
  {
    name: 'Kokpit assistant',
    what: 'Tool-calling agent with human confirmation',
    when: 'Aug 2026 to now',
    href: '/work/assistant/',
    points: [
      'Designed an agent whose write tools only create proposals; the database applies a change after a person confirms. Added a number guard, injection defence and pseudonymisation of personal data.',
      `Built its evaluation: 132 offline cases on every commit and 105 live cases; ${FACTS.evalPass} passed (DeepSeek, November 2026) at about ${FACTS.evalCost} an answer. Found and repaired faults in the evaluation itself before tuning the assistant.`,
    ],
  },
  {
    name: 'Showroom',
    what: 'AI photo studio, in development',
    when: 'Oct 2026 to now',
    href: '/work/showroom/',
    points: [
      'Pipeline that replaces only the background of a car photo: BiRefNet and SAM 2.1 on a GPU through ONNX Runtime (Python), then a deterministic renderer with Blender scenes, golden-image tests and colour-fidelity checks.',
    ],
  },
  {
    name: 'Automobili Galerija',
    what: 'Live dealership site and back office',
    when: 'Nov 2025 to Sep 2026',
    href: '/work/galerija/',
    points: [
      'Turned my family dealership’s daily work into one system: catalogue, inquiries, trade-ins, offers, window stickers and feeds for five ad portals. In daily use.',
      'In-browser background removal with ONNX in WebAssembly; chose the model by measurement (edge agreement 0.874 to 0.974).',
    ],
  },
  {
    name: 'Intake Eval',
    what: 'Public LLM evaluation harness',
    when: 'Sep 2026',
    href: '/work/intake-eval/',
    points: ['TypeScript harness that validates structured model output and evidence quotes, with a browser playground, a failure lab and a human-review workspace. Results reproduce offline with one command.'],
  },
];

const SKILLS = [
  ['AI engineering', 'Tool-calling agents, LLM evaluation, prompt-injection defence, structured extraction, vision models, pseudonymisation, cost control'],
  ['Platform', 'TypeScript, Next.js, React, Postgres with row-level security, Supabase, Python, multi-tenant architecture, CI/CD'],
  ['Quality', 'Vitest, Playwright, accessibility to WCAG AA, golden-image tests, security review'],
  ['Method', 'Directing coding agents (Claude Code, Codex), specifications, decision records, second-model review'],
];
---
<Base title="CV" description="CV of Leon Bede, AI product engineer." sheet="C-001" drawing="Curriculum vitae">
  <article class="cv wrap">
    <header class="cv__head">
      <div>
        <h1 class="title">{SITE.name}</h1>
        <p class="cv__role lt">{SITE.role}</p>
      </div>
      <ul class="cv__contact">
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.origin}>leonbede7.github.io</a></li>
        <li><a href={SITE.linkedin}>linkedin.com/in/leon-bede</a></li>
        <li><a href={SITE.github}>github.com/leonbede7</a></li>
        <li>{SITE.location}</li>
      </ul>
    </header>

    <p class="cv__get no-print"><a class="cell cell--solid" href="/leon-bede-cv.pdf" download>Download as PDF <Arrow /></a></p>

    <section class="cv__sec">
      <h2 class="lt">Profile</h2>
      <p class="cv__profile">AI product engineer. I design LLM features around real business work and ship them by directing coding agents (Claude Code, Codex), with the evaluation, tests and review that make agent-written code safe to rely on; I own and can defend every architectural decision. I built Kokpit, a platform for car dealerships that runs my family’s dealership and a public demo installation. {SITE.availability}, with {SITE.eligibility}.</p>
    </section>

    <section class="cv__sec">
      <h2 class="lt">Engineering experience</h2>
      <div class="cv__work">
        {WORK.map((w) => (
          <div class="job">
            <h3><a href={w.href}><b class="title">{w.name}</b></a> <span>{w.what}</span></h3>
            <p class="job__when lt tnum">{w.when}</p>
            <ul>{w.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <div class="cv__two">
      <section class="cv__sec">
        <h2 class="lt">Other experience</h2>
        <div class="job">
          <h3><b class="title">Automobili Galerija</b> <span>Business operations and AI product development</span></h3>
          <p class="job__when lt tnum">2021 to present</p>
          <ul><li>Daily dealership work in stock, inquiries, trade-ins and sales; turned that into the requirements for the products above and own their direction.</li></ul>
        </div>
        <div class="job">
          <h3><b class="title">Hrvatski Telekom</b> <span>Sales and customer service agent</span></h3>
          <p class="job__when lt tnum">Summer 2024</p>
          <ul><li>Explained service options to customers and regularly exceeded individual sales targets.</li></ul>
        </div>
      </section>

      <section class="cv__sec">
        <h2 class="lt">Education</h2>
        <div class="job">
          <h3><b class="title">FERIT Osijek</b> <span>Undergraduate Computing, Software Engineering track</span></h3>
          <p class="job__when lt">In progress</p>
        </div>
        <h2 class="lt cv__h2b">Languages</h2>
        <p>Croatian, native. English, working proficiency.</p>
      </section>
    </div>

    <section class="cv__sec">
      <h2 class="lt">Skills</h2>
      <dl class="cv__skills">
        {SKILLS.map(([k, v]) => <div><dt class="lt">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <p class="cv__note">The code in these projects was written by AI coding agents under my direction. Figures measured {FACTS.measured}.</p>
  </article>
</Base>

<style>
  .cv { padding-block: clamp(2rem, 5vw, 4rem) 1rem; max-width: 62rem; }
  .cv__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; border-bottom: var(--wall) solid var(--poche); padding-bottom: 1.2rem; }
  .cv__head h1 { font-size: clamp(3rem, 2rem + 5vw, 5.4rem); }
  .cv__role { font-size: var(--step-1); margin-top: 0.3rem; }
  .cv__contact { font-size: var(--step--1); line-height: 1.55; text-align: right; font-weight: 500; }
  .cv__get { margin-top: 1.4rem; }
  .cv__get .cell { font-size: var(--step--1); }
  .cv__sec { margin-top: 2rem; }
  .cv__sec h2 { font-size: var(--step-0); color: var(--ink-2); border-bottom: 1px solid var(--poche); padding-bottom: 0.35rem; margin-bottom: 0.8rem; }
  .cv__h2b { margin-top: 1.6rem; }
  .cv__profile { font-size: var(--step-0); max-width: 52em; font-weight: 500; }
  .cv__work { display: grid; gap: 1.1rem; }
  .job { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.15rem 1.5rem; align-items: baseline; }
  .job + .job { margin-top: 0.9rem; }
  .cv__work .job + .job { margin-top: 0; }
  .job h3 { font-size: var(--step-0); font-weight: 500; }
  .job h3 b { font-size: var(--step-1); margin-right: 0.4em; }
  .job h3 a { text-decoration: none; }
  .job h3 a:hover b { text-decoration: underline; text-decoration-color: var(--sun-deep); }
  .job__when { font-size: var(--step--1); color: var(--ink-2); white-space: nowrap; }
  .job ul { grid-column: 1 / -1; display: grid; gap: 0.3rem; font-size: var(--step--1); line-height: 1.45; margin-top: 0.25rem; max-width: 60em; }
  .job li { padding-left: 1.2em; position: relative; }
  .job li::before { content: ''; position: absolute; left: 0; top: 0.68em; width: 0.65em; border-top: var(--wall) solid var(--poche); }
  .cv__two { display: grid; grid-template-columns: 1.4fr 1fr; gap: 0 3rem; }
  .cv__skills div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--rule); font-size: var(--step--1); line-height: 1.45; }
  .cv__skills dt { color: var(--ink-2); }
  .cv__note { margin-top: 1.6rem; font-size: var(--step--1); color: var(--ink-2); }
  @media (max-width: 46rem) {
    .cv__contact { text-align: left; }
    .cv__two { grid-template-columns: 1fr; }
    .job { grid-template-columns: 1fr; }
    .cv__skills div { grid-template-columns: 1fr; gap: 0.1rem; }
  }
  @media print {
    @page { size: A4; margin: 11mm 13mm; }
    :global(html) { font-size: 8.7pt; }
    :global(body) { background: #fff; }
    :global(.tb) { display: none; }
    .cv { padding: 0; max-width: none; }
    .cv__head h1 { font-size: 34pt; }
    .cv__sec { margin-top: 8pt; break-inside: avoid; }
    .cv__head { padding-bottom: 6pt; }
    .cv__sec h2 { margin-bottom: 4pt; }
    .cv__note { margin-top: 8pt; }
    .cv__work .job { break-inside: avoid; }
    .cv__work { gap: 5pt; }
    a { text-decoration: none; }
  }
</style>
