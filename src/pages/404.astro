---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Not on the drawings" description="This page does not exist." sheet="X-404" drawing="A room that is not on the drawings">
  <section class="lost wrap">
    <h1 class="title">This room is <span class="lit">not on the drawings.</span></h1>
    <p>The address you followed does not lead anywhere in this building. The room schedule lists everything that does.</p>
    <p class="lost__go"><a class="cell cell--solid" href="/#rooms">Open the room schedule <Arrow /></a> <a class="cell" href="/">Back to the section <Arrow /></a></p>
  </section>
</Base>

<style>
  .lost { padding-block: clamp(4rem, 14vh, 10rem); }
  .lost h1 { font-size: var(--step-4); max-width: 14em; }
  .lost p { font-size: var(--step-1); max-width: 30em; margin-top: 1.4rem; font-weight: 500; }
  .lost__go { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .lost__go .cell { font-size: var(--step-0); }
</style>
